# API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=1
# Native Windows defaults to solo automatically.
# CELERY_WORKER_POOL=prefork

# Workspace
WORKSPACE_DIR=/data/workspace

# Python raster engine + CTB tiler tile-decode cache (MB).
GDAL_CACHEMAX=512

# Job retention (seconds)
JOB_TTL=604800

# Terrain tile publishing (nginx terrain-server)
TERRAIN_SERVER_PUBLIC_URL=http://localhost:8103
TERRAIN_BASE_PATH=/tilesets
AUTO_PUBLISH=false
