# API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Workspace
WORKSPACE_DIR=/data/workspace
# Preferred on Docker Desktop: fallback CTB mounts this named volume (fast Linux FS).
# Must match docker-compose.yml volume name.
WORKSPACE_DOCKER_VOLUME=ocean-terrain-handler_workspace_data
# Only needed when using docker-compose.host-data.yml (full ./data bind mount).
# Use forward slashes. Example (Windows): D:/workspace/ocean-terrain-handler/data
# HOST_WORKSPACE_DIR=D:/workspace/ocean-terrain-handler/data

# CTB tiling: auto (native C++ if it meets the bar, else docker ctb-tile), native, or docker.
CTB_BACKEND=auto
# Docker ctb-tile image used when native meshing/encoding is unavailable or too slow.
CTB_DOCKER_IMAGE=cesium-terrain-builder:local

# Python raster engine + CTB tiler tile-decode cache (MB). Also passed to docker CTB.
GDAL_CACHEMAX=512

# Job retention (seconds)
JOB_TTL=604800

# Terrain tile publishing (nginx terrain-server)
TERRAIN_SERVER_PUBLIC_URL=http://localhost:8103
TERRAIN_BASE_PATH=/tilesets
AUTO_PUBLISH=false
