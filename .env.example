# API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Workspace (mounted volume for input/output)
WORKSPACE_DIR=/data/workspace
# Host-side path of ./data for docker -v when worker invokes CTB via docker.sock
# Use forward slashes. Example (Windows): D:/workspace/ocean-terrain-handler/data
HOST_WORKSPACE_DIR=D:/workspace/ocean-terrain-handler/data

# CTB Docker image (locally built from cesium-terrain-builder master-quantized-mesh)
CTB_DOCKER_IMAGE=cesium-terrain-builder:local

# GDAL performance
GDAL_CACHEMAX=512

# Job retention (seconds)
JOB_TTL=604800

# Terrain tile publishing (cesium-terrain-server)
TERRAIN_SERVER_PUBLIC_URL=http://localhost:8081
TERRAIN_BASE_PATH=/tilesets
AUTO_PUBLISH=true
