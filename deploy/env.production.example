# Bare-metal production environment.
# Install as /etc/ocean-terrain-handler/env on Linux.

APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_WORKER_CONCURRENCY=1
# CELERY_WORKER_POOL=prefork

# Must match deploy/nginx-baremetal.conf.
WORKSPACE_DIR=/var/lib/ocean-terrain-handler/data
GDAL_CACHEMAX=512
JOB_TTL=604800

TERRAIN_SERVER_PUBLIC_URL=http://your-server:8103
TERRAIN_BASE_PATH=/tilesets
AUTO_PUBLISH=false
